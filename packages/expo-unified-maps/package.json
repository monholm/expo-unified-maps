{
  "name": "expo-unified-maps",
  "version": "0.0.0",
  "exports": {
    ".": "./dist/index.js",
    "./app.plugin.js": "./app.plugin.js"
  },
  "files": [
    "dist",
    "expo-module.config.json",
    "app.plugin.js",
    "plugin/dist",
    "android",
    "!android/build",
    "ios"
  ],
  "description": "A unified maps module for Expo",
  "repository": "https://github.com/monholm/expo-unified-maps",
  "bugs": {
    "url": "https://github.com/monholm/expo-unified-maps/issues"
  },
  "author": "monholm <73996878+monholm@users.noreply.github.com> (https://github.com/monholm)",
  "homepage": "https://github.com/monholm/expo-unified-maps#readme",
  "scripts": {
    "watch": "tsc -p tsconfig.build.json --watch",
    "expo": "expo",
    "build": "tsc -p tsconfig.build.json",
    "build:plugin": "tsc -p plugin/tsconfig.json",
    "check": "tsc",
    "lint": "eslint . --max-warnings 0",
    "format-check": "prettier . --check --cache-location=_unused",
    "format": "prettier . --write --cache-location=_unused"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@monholm/eslint-config": "3.0.0",
    "@monholm/prettier-config": "2.0.2",
    "@monholm/tsconfig": "2.2.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/react": "catalog:expo",
    "eslint": "9.39.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "6.1.1",
    "expo": "catalog:expo",
    "prettier": "3.8.1",
    "react": "catalog:expo",
    "react-native": "catalog:expo",
    "typescript": "5.9.3",
    "typescript-eslint": "8.58.0"
  }
}
